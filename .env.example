# Names only. Real values go in .env.local (git-ignored), Supabase secrets or GitHub Actions secrets.

# Client (Vite exposes only VITE_* variables to the app). Dev project values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local tooling: the dev project ref only. Never the live project.
SUPABASE_PROJECT_REF_DEV=
